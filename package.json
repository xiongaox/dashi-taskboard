{
  "name": "antigravity-taskboard",
  "version": "1.1.8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "taskctl": "./cli/taskctl.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.mjs --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "start": "node server/index.mjs",
    "taskctl": "node cli/taskctl.mjs",
    "test": "node --test && npm run test:components",
    "test:components": "vitest run web/src/components/MarkdownDocument.test.tsx --environment jsdom",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "dhtmlx-gantt": "^10.0.0",
    "dompurify": "^3.4.13",
    "js-yaml": "4.1.1",
    "mdast-util-definitions": "^6.0.0",
    "mermaid": "^11.16.1",
    "micromark-util-decode-string": "^2.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.8.0",
    "unified": "^11.0.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^27.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
